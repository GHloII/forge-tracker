    "prepare": "svelte-kit sync",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "svelte": "^5.43.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.17",
    "typescript": "6.0.3",
    "vite": "^8.3.6"
  }
}
