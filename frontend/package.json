{
  "name": "forge-tracker-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
