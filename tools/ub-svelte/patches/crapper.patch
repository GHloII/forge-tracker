@@ -0,0 +1,31 @@
+from crapper.discover import language_of
+from crapper.languages.typescript import functions_in_source
+
+
+def test_component_functions_keep_original_lines_and_ignore_markup():
+    source = '''<!-- <script>function fake() { return false; }</script> -->
+<script lang="ts">
+function choose(n: number) { return n > 0 ? 1 : 0; }
+</script>
+<button onclick={() => true}>Привет</button>
+<style>.x { color: red; }</style>'''
+    assert language_of('src/View.svelte') == 'typescript'
+    functions = functions_in_source(source, 'src/View.svelte', '/proj')
+    assert [(fn.name, fn.start_line, fn.complexity) for fn in functions] == [('choose', 3, 2)]
+
+
+def test_mask_preserves_utf8_offsets_and_script_text():
+    from crapper.languages.svelte import script_source
+    source = 'Привет\r\n<script lang="ts" data-test=">">\r\nconst n = $state(1);\r\n</script>\r\n<p>{n > 0}</p>'
+    masked = script_source(source).encode()
+    original = source.encode()
+    assert len(masked) == len(original)
+    start = original.index(b'const')
+    assert masked[start:start + 20] == original[start:start + 20]
+    assert [i for i, b in enumerate(masked) if b in (10, 13)] == [i for i, b in enumerate(original) if b in (10, 13)]
+    assert b'<p>' not in masked
+
+
+def test_both_module_and_instance_scripts_are_found():
+    source = '<script module>export function shared() { return true; }</script>\n<script>function local() { return false; }</script>'
+    assert [fn.name for fn in functions_in_source(source, 'Both.svelte')] == ['shared', 'local']
