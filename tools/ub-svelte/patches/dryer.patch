@@ -0,0 +1,51 @@
+from dryer.discover import language_of
+from dryer.extract import entries_in_source
+from dryer.scan import find_duplicates
+from dryer.scan import scan_files
+
+
+SOURCE = '''<script module lang="ts">
+export function shared(xs: number[]) {
+  return xs.filter(x => x > 0);
+}
+</script>
+<h1>Привет</h1>
+<script lang="ts">
+function instance(items: number[]) {
+  return items.filter(item => item > 0);
+}
+</script>
+<button onclick={() => false}>Run</button>
+<style>.x { width: calc(1px + 2px); }</style>
+'''
+
+
+def test_svelte_is_discovered_as_typescript():
+    assert language_of('Widget.svelte') == 'typescript'
+
+
+def test_svelte_compares_both_scripts_and_keeps_source_lines():
+    entries, warning = entries_in_source('typescript', SOURCE, 'Widget.svelte', 'Widget.svelte')
+    assert warning is None
+    assert [(entry.start_line, entry.end_line) for entry in entries] == [(2, 4), (8, 10)]
+    duplicates = find_duplicates(entries, threshold=0.99)
+    assert len(duplicates) == 1
+
+
+def test_svelte_does_not_treat_markup_or_style_as_functions():
+    source = '<button onclick={() => true}>Run</button><style>function fake() {}</style>'
+    entries, warning = entries_in_source('typescript', source, 'Empty.svelte', 'Empty.svelte')
+    assert entries == []
+    assert warning is None
+
+
+def test_svelte_and_typescript_duplicates_are_compared(tmp_path):
+    component = tmp_path / 'Widget.svelte'
+    module = tmp_path / 'helpers.ts'
+    component.write_text(SOURCE, encoding='utf-8')
+    module.write_text('export function positives(values: number[]) {\n'
+                      '  return values.filter(value => value > 0);\n}\n', encoding='utf-8')
+    entries, warnings = scan_files([component, module], tmp_path, min_lines=1, min_nodes=1)
+    assert warnings == []
+    duplicates = find_duplicates(entries, threshold=0.99)
+    assert any(pair.left.file != pair.right.file for pair in duplicates)
