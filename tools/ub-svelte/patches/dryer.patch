+"""Expose inline Svelte scripts without moving any UTF-8 byte or line position.
+
+Template expressions and styles are deliberately excluded. Svelte runes are
+ordinary call expressions to the TypeScript parser.
+"""
+
+from html.parser import HTMLParser
+
+
+class _Scripts(HTMLParser):
+    def __init__(self, source: str):
+        super().__init__(convert_charrefs=False)
+        self.source = source
+        self.lines = [0]
+        self.lines.extend(i + 1 for i, char in enumerate(source) if char == '\n')
+        self.spans: list[tuple[int, int]] = []
+        self.in_script = False
+
+    def handle_starttag(self, tag, attrs):
+        if tag == 'script':
+            attributes = dict(attrs)
+            self.in_script = 'src' not in attributes and attributes.get('type', '').lower() in {
+                '', 'module', 'text/javascript', 'application/javascript',
+                'text/ecmascript', 'application/ecmascript',
+            }
+
+    def handle_endtag(self, tag):
+        if tag == 'script':
+            self.in_script = False
+
+    def handle_data(self, data):
+        if self.in_script:
+            row, col = self.getpos()
+            start = self.lines[row - 1] + col
+            self.spans.append((start, start + len(data)))
+
+
+def script_source(source: str) -> str:
+    parser = _Scripts(source)
+    parser.feed(source)
+    parser.close()
+    original = source.encode('utf-8')
+    masked = bytearray(byte if byte in (10, 13) else 32 for byte in original)
+    for start, end in parser.spans:
+        first = len(source[:start].encode('utf-8'))
+        last = first + len(source[start:end].encode('utf-8'))
+        masked[first:last] = original[first:last]
+    return masked.decode('utf-8')
